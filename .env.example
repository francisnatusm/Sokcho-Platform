ANTHROPIC_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# One line with \n escapes. In Vercel: no surrounding quotes.
FIREBASE_PRIVATE_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KTO_API_KEY=
KMA_API_KEY=
DATA_GO_KR_API_KEY=
BRIGHT_DATA_API_KEY=
VITE_MAPTILER_API_KEY=
# Leave empty on Vercel (same-origin /api). Locally use http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000
# Comma-separated production site origins, e.g. https://sokcho-platform.vercel.app
CLIENT_ORIGIN=

# Local Windows only if antivirus SSL inspection blocks Node. Leave empty/false on Vercel.
ALLOW_INSECURE_TLS=
